# Scoring engine: math (default) | mock (fixtures only) | tribe-local | tribe-gcp
COGNARC_SCORING_ENGINE=math
# TRIBE falls back to CME on unavailable or synthetic inference (text only)
COGNARC_FALLBACK_ENABLED=true

# Canonical scoring origin, used by server-side dashboard gateways
# Must point to cognitive-scoring /score, not TRIBE /predict
COGNARC_SCORING_URL=
# Secret configured in scoring service and all server-side API adapters
COGNARC_SCORING_SERVICE_SECRET=

# HuggingFace (required for TRIBE v2 + LLaMA 3.2 access)
HF_TOKEN=hf_xxx

# GCP (required for Cloud Run deployment)
GCP_PROJECT_ID=cognarc-202605
GCP_REGION=us-central1
GCP_TRIBE_ENDPOINT=https://tribe-inference-xxx-uc.a.run.app

# Database
COGNARC_DB_URL=postgresql://cognarc:password@localhost:5432/cognarc
COGNARC_REDIS_URL=redis://localhost:6379

# Audit log WORM enforcement
COGNARC_AUDIT_WORM=true

# Analytics connectors (add as you connect platforms)
# SEGMENT_WEBHOOK_SECRET=whsec_xxx
# AMPLITUDE_API_KEY=xxx
# SLACK_WEBHOOK_URL=https://hooks.slack.com/xxx
