{
  "buildCommand": "turbo run build --filter=@cognarc/dashboard...",
  "outputDirectory": "apps/dashboard/dist",
  "functions": {
    "api/score.ts": { "maxDuration": 120 },
    "api/score-stream.ts": { "maxDuration": 120 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/score", "destination": "/api/score" },
    { "source": "/api/score-stream", "destination": "/api/score-stream" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
