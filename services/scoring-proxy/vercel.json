{
  "functions": {
    "api/score.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 120
    },
    "api/score-stream.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/score", "destination": "/api/score" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://cognarc-dashboard.vercel.app" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-CognArc-Key" }
      ]
    }
  ]
}
